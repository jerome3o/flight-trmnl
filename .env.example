# Copy to .env and fill in your real values. .env is gitignored.
# LAT and LON are REQUIRED — the app refuses to start without them, and this
# repo ships no default location. The values below are placeholders.
# This file uses docker-compose env_file format: KEY=value (no quotes needed).

# --- observer location (REQUIRED) + view cone ---
LAT=51.5074
LON=-0.1278
BEARING=135        # compass heading the window faces
FOV=145            # field of view in degrees
RANGE_KM=5
MIN_ELEV=8         # min elevation angle to count as "in view"

# --- data source ---
SOURCE=adsblol     # adsblol | airplaneslive | adsbfi
# The sky is rescanned on a background thread, so a slow upstream costs the
# board freshness rather than stalling a render. Renders just read the last
# good scan. Be considerate: these feeds are free and community-run, and this
# is the only setting that multiplies traffic to them.
# BOARD_REFRESH_S=10         # seconds between scans
# ADSB_TIMEOUT_S=10          # give up on a scan after this
# ROUTE_TIMEOUT_S=4          # per route-database request

# --- arrival prediction ---
# The board also lists traffic predicted to enter the cone shortly. The scan
# radius is bounded by how accurate a straight-line projection can be, not by
# how far an aircraft could travel: passing within RANGE_KM of you needs the
# heading right to ~±9.5° from 30 km away, but ~±2° from 140 km — tighter than
# the turns terminal traffic makes constantly, so distant predictions are just
# noise. Keep RANGE and HORIZON consistent (30 km at approach speeds ≈ 4 min).
# PREDICT_RANGE_KM=30        # how far out to look for approaching traffic
# PREDICT_HORIZON_MIN=4      # how far ahead to project
# PREDICT_CONFIRM_S=90       # seconds a prediction must persist before it
#                            # earns a row, so one noisy projection can't flash
#                            # a flight on and off. 0 disables it. Seconds, not
#                            # a count of scans, so it keeps its meaning if
#                            # BOARD_REFRESH_S changes. The old PREDICT_CONFIRM
#                            # is still read, as a count of 30 s renders.
# PREDICT_MISS_MAX_KM=0      # 0 = off. Otherwise drop predictions whose closest
#                            # approach is farther than this — lower it toward 0
#                            # to keep only aircraft passing near overhead.
# MAX_BOARD_FLIGHTS=14       # rows on the board

# --- turning traffic ---
# When the ADS-B feed reports bank angle or rate of turn, the projection flies
# the aircraft round its actual arc instead of a straight line, and an aircraft
# banking onto a nearby approach is badged with that airport on the board. Both
# fields are optional in the feed — watch TURN on the board's DIAG strip for
# how many of the scanned aircraft actually report them. Zero means your feed
# carries neither and everything falls back to straight-line projection.
# The approach badge is cross-checked against the filed destination: an
# aircraft banking across Heathrow on its way to Gatwick is not turning for
# Heathrow, and the claim is dropped. Flights whose route never resolves keep
# the geometric claim, since it is the best evidence available for those.
# TURN_ENABLED=1             # OFF by default. Turns on arc projection, the
#                            # approach badge and the arc drawn on the map.
#                            # Disabled, all three revert to straight-line.
# TURN_MIN_DPS=0.4           # deg/s below which an aircraft counts as level
# APPROACH_MAX_KM=45         # only claim "turning for X" this close to the field
# APPROACH_MAX_FT=12000      # ...and only below this altitude

# --- BYOS device auth (REQUIRED for a public deployment) ---
# Secret used to derive each device's api_key AND the unguessable board-image
# URL. Anyone who knows it can view your board, so use a long random value:
#   python3 -c "import secrets; print(secrets.token_hex(24))"
DEVICE_SALT=change-me-to-a-long-random-secret

# --- panel resolution: match YOUR device (firmware rejects wrong sizes) ---
# TRMNL X  (10.3"):  1872 x 1404, 4bit   <- default
# TRMNL OG (7.5") :   800 x 480,  2bit  (or 1bit legacy)
RENDER_WIDTH=1872
RENDER_HEIGHT=1404
RENDER_DEPTH=4bit

# --- route lookup (origin/destination/flight number) ---
# ADS-B carries no route, so the callsign is resolved against community route
# databases. These are free, need no key and have no quota; adsbdb also carries
# the IATA flight number (BAW172 -> BA172), which is what the board and the map
# markers show. Order them with ROUTE_PROVIDERS; a miss in one is not a miss
# overall, so leaving both in place is worthwhile.
# ROUTE_PROVIDERS=adsbdb,hexdb   # adsbdb | hexdb | adsblol
# ROUTE_STRICT=1                 # require two DBs to agree, else show no route
# ROUTE_ENRICH_MAX=14            # board flights resolved per render
# ROUTE_MAX_NEW=8                # new callsigns looked up per render
# ROUTE_BUDGET_S=8               # wall-clock budget for those lookups
# DEBUG_ROUTES=1                 # log every lookup to stderr

# --- FlightRadar24 API (optional gap-filler; OFF by default) ---
# FR24_ENABLED=1               # required as well as a key before any credit
#                              # is spent — the code stays for when it is
#                              # wanted again, the switch keeps it dormant
# Only consulted for callsigns the free databases above could not resolve, and
# only while under the monthly cap — FR24 bills 8 credits per flight and the
# Explorer tier is 30000/month. Leave F24_KEY unset to run entirely free; the
# board's DIAG strip shows "FR24 +N" for how many flights needed it.
# F24_KEY=your-fr24-api-token
# FR24_MONTHLY_CREDITS=29000   # safety cap (stop enriching before the real limit)
# FR24_ROUTE_TTL=3600          # seconds to cache a flight's route

# --- TRMNL cloud push (optional; not needed for BYOS) ---
# TRMNL_PLUGIN_UUID=plugin-setting-uuid
# TRMNL_PLUS=1
